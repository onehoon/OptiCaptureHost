#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OC_VER_MAJOR, OC_VER_MINOR, OC_VER_PATCH, 0
 PRODUCTVERSION OC_VER_MAJOR, OC_VER_MINOR, OC_VER_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OptiCaptureHost contributors"
            VALUE "FileDescription", "OptiCaptureHost capture launcher"
            VALUE "FileVersion", OC_VER_STR
            VALUE "InternalName", "OptiCaptureLauncher"
            VALUE "LegalCopyright", "Copyright (C) MK-JH"
            VALUE "OriginalFilename", "OptiCaptureLauncher.exe"
            VALUE "ProductName", "OptiCaptureHost"
            VALUE "ProductVersion", OC_VER_STR
            VALUE "Comments", "Modified development fork, 2026-11-24"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
